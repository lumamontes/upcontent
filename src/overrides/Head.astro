---
// Override do Head.astro do Starlight (registrado via starlight({ components })
// no astro.config.mjs). A homepage usa o mesmo nome do produto como título da
// página e do site; remova o título duplicado só nessa rota.
import MermaidLoader from '../components/MermaidLoader.astro'
import StructuredDataCopy from '../components/StructuredDataCopy.astro'
import { getPortalConfig } from '../lib/portal-config'
import { PRODUCT_NAME } from '../lib/product-identity'

const { head } = Astro.locals.starlightRoute
const { entry } = Astro.locals.starlightRoute
const normalizedBasePath = import.meta.env.BASE_URL.replace(/\/+$/, '')
const isHome = Astro.url.pathname.replace(/\/+$/, '') === normalizedBasePath
const baseHead = isHome ? head.filter(({ tag }) => tag !== 'title') : head
const config = getPortalConfig()
const seoEnabled = config.seo?.enabled === true && Boolean(Astro.site)
const siteTitle = config.site?.title ?? PRODUCT_NAME
const pageData = entry?.data ?? {}
const seoHead = seoEnabled
  ? baseHead
  : baseHead.filter(({ tag, attrs }) => {
      const property = typeof attrs?.property === 'string' ? attrs.property : undefined
      const name = typeof attrs?.name === 'string' ? attrs.name : undefined
      return !(tag === 'meta' && (property?.startsWith('og:') || name?.startsWith('twitter:')))
    })
const canonicalTag = seoHead.find(({ tag, attrs }) => tag === 'link' && attrs?.rel === 'canonical')
const canonicalUrl = seoEnabled
  ? typeof pageData.canonical === 'string'
    ? pageData.canonical
    : typeof canonicalTag?.attrs?.href === 'string'
      ? canonicalTag.attrs.href
      : undefined
  : undefined
const pageHead = pageData.canonical || config.site?.locale
  ? seoHead.filter(({ tag, attrs }) =>
      !(pageData.canonical && tag === 'link' && attrs?.rel === 'canonical')
      && !(pageData.canonical && tag === 'meta' && attrs?.property === 'og:url')
      && !(config.site?.locale && tag === 'meta' && attrs?.property === 'og:locale'),
    )
  : seoHead
const socialImage = seoEnabled && (typeof pageData.image === 'string' ? pageData.image : config.site?.socialImage)
const robots = !seoEnabled || pageData.noindex === true ? 'noindex, nofollow' : undefined
const pageTitle = typeof pageData.title === 'string' ? pageData.title : siteTitle
const pageDescription = typeof pageData.description === 'string' ? pageData.description : config.site?.description
const absoluteImage = resolveOptionalUrl(socialImage, canonicalUrl)
const siteRoot = canonicalUrl && Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : undefined
const breadcrumbItems = canonicalUrl
  ? [{ '@type': 'ListItem', position: 1, name: siteTitle, item: siteRoot },
     ...(isHome ? [] : [{ '@type': 'ListItem', position: 2, name: pageTitle, item: canonicalUrl }])]
  : []
const structuredData = canonicalUrl
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${siteRoot}#website`,
          url: siteRoot,
          name: siteTitle,
          description: config.site?.description,
          inLanguage: config.site?.locale,
        },
        {
          '@type': 'TechArticle',
          '@id': `${canonicalUrl}#article`,
          url: canonicalUrl,
          headline: pageTitle,
          description: pageDescription,
          isPartOf: { '@id': `${siteRoot}#website` },
          image: absoluteImage,
          dateModified: pageData.updated,
          breadcrumb: { '@type': 'BreadcrumbList', itemListElement: breadcrumbItems },
        },
      ],
    }
  : undefined;
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/[<>&]/g, character => ({ '<': '\\u003c', '>': '\\u003e', '&': '\\u0026' })[character]!)
  : undefined

function resolveOptionalUrl(value: unknown, baseUrl: string | undefined): string | undefined {
  if (typeof value !== 'string' || value.length === 0) return undefined
  try {
    const url = new URL(value, baseUrl)
    return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : undefined
  } catch {
    return undefined
  }
}
---

{pageHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<slot />
{isHome && <title>{siteTitle}</title>}
{seoEnabled && pageData.canonical && <link rel="canonical" href={canonicalUrl} />}
{seoEnabled && pageData.canonical && <meta property="og:url" content={canonicalUrl} />}
{seoEnabled && config.site?.locale && <meta property="og:locale" content={config.site.locale} />}
{absoluteImage && <meta property="og:image" content={absoluteImage} />}
{absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
{robots && <meta name="robots" content={robots} />}
{structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
<MermaidLoader />
<StructuredDataCopy />
